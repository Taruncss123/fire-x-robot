# ==============================================================================
# FIRE-X COMMAND CENTER - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Node.js Express & WebSocket Bridge Backend
PORT=5001
BATCH_INTERVAL_MINUTES=5

# Frontend WebSocket Target (Used by Next.js in the browser)
NEXT_PUBLIC_WS_URL=ws://localhost:5001

# Raspberry Pi Camera Stream (MJPEG or WebRTC endpoint)
# e.g., http://192.168.1.150:8080/stream.mjpg
NEXT_PUBLIC_CAMERA_STREAM_URL=

# MQTT Broker Configuration (HiveMQ Cloud / EMQX / Mosquitto)
# Free public broker for testing: mqtt://broker.emqx.io:1883
# For secure WebSocket or TLS: wss://xxx.hivemq.cloud:8884
MQTT_BROKER_URL=mqtt://broker.emqx.io:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# Firebase Firestore (Optional - Local cache fallback automatically active if empty)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
